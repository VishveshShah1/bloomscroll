{
  "manifest_version": 3,
  "name": "Bloomscroll — check the claim",
  "short_name": "Bloomscroll",
  "version": "0.1.0",
  "description": "Right click any claim, video, or article to check it against real scientific literature on Bloomscroll.",
  "action": {
    "default_title": "Check with Bloomscroll",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "activeTab", "storage"]
}
